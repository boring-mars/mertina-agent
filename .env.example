# Mertina Agent configuration.
#
# Copy this file to `.env` and fill in real values; `.env` is gitignored.
# Settings variables fall back to the defaults shown here. The explicit model
# smoke example requires an existing env file and explicitly supplied endpoint
# and model. Environment variables always win over the `.env` file.

# Log threshold: DEBUG | INFO | WARNING | ERROR | CRITICAL
MERTINA_LOG_LEVEL=INFO

# Base HTTP(S) URL of an OpenAI-compatible Chat Completions endpoint. Choose the
# actual service you intend to call; hosted requests may incur charges. Use only
# the base path, without URL credentials, query parameters or a fragment.
MERTINA_LLM_BASE_URL=https://api.openai.com/v1

# Credential for that endpoint, if required. Leave empty for an unauthenticated
# endpoint: no Authorization header is sent, and OPENAI_API_KEY is never used as
# a fallback. Never commit a real key.
MERTINA_LLM_API_KEY=

# Non-empty model name sent with every request; use a name your endpoint supports.
MERTINA_LLM_MODEL=gpt-4o-mini

# SDK network-operation timeout in seconds, not a total agent-turn deadline.
# Must be greater than 0. The SDK itself never retries; see the next setting.
MERTINA_LLM_TIMEOUT_S=60

# Attempts per model call, including the first. Timeouts, connection failures,
# HTTP 408/429/5xx and malformed responses are retried with jittered backoff
# (or the provider's Retry-After). Must be at least 1; 1 disables retries.
MERTINA_LLM_MAX_ATTEMPTS=3

# Stream model responses so text and tool progress are reported as they arrive.
# Set to false for endpoints that do not support streaming.
MERTINA_LLM_STREAM=true

# Model calls one agent turn may spend on the tool loop before the agent asks
# the model for a summary. Must be at least 1.
MERTINA_MAX_ITERATIONS=10

# Provider behind the web_search tool. Only ddgs (DuckDuckGo, no API key) is
# available; it runs each search in a separate process.
MERTINA_WEB_SEARCH_BACKEND=ddgs

# Hard wall-clock limit in seconds for one web search. Must be greater than 0.
MERTINA_WEB_SEARCH_TIMEOUT_S=30

# One database per process. SQLite defaults to ~/.mertina/mertina.sqlite3.
# Use a separate file/database per development branch; never commit real DSNs.
# SQLite example: sqlite+aiosqlite:////absolute/path/mertina.sqlite3
# PostgreSQL: postgresql+asyncpg://USER:PASSWORD@127.0.0.1:55432/DATABASE
# MySQL: mysql+asyncmy://USER:PASSWORD@127.0.0.1:53306/DATABASE
# MERTINA_DATABASE_URL=sqlite+aiosqlite:///./mertina.sqlite3

# Opening the database (including its health check) and pool acquisition budget.
MERTINA_DATABASE_CONNECT_TIMEOUT_S=10
# Whole short transaction budget, including its SQL and commit; no LLM work inside.
MERTINA_DATABASE_TIMEOUT_S=30
MERTINA_DATABASE_POOL_SIZE=5
MERTINA_DATABASE_MAX_OVERFLOW=5
# Verified TLS with system trust roots for PostgreSQL/MySQL. Local Docker uses false.
MERTINA_DATABASE_SSL=false
# SQLite lock wait budget; foreign keys, WAL and synchronous=FULL are enabled.
MERTINA_DATABASE_SQLITE_BUSY_TIMEOUT_MS=5000

# Single-process, single-user HTTP Gateway. A literal loopback address only.
# Port 0 chooses an ephemeral port (useful for tests); normal default is 8765.
MERTINA_GATEWAY_HOST=127.0.0.1
MERTINA_GATEWAY_PORT=8765
# Prefer `python -m mertina_agent.state init` once, then start with false.
# True can initialize a completely empty namespace; never upgrades an existing schema.
MERTINA_GATEWAY_BOOTSTRAP=false
# Cooperative stop/commit budget, followed by forced cancellation/cleanup budget.
MERTINA_GATEWAY_SHUTDOWN_TIMEOUT_S=30
MERTINA_GATEWAY_CANCEL_TIMEOUT_S=5
# Completed runs expire after this many seconds; oldest completed runs may be evicted sooner.
MERTINA_GATEWAY_RUN_TTL_S=900
MERTINA_GATEWAY_MAX_RUNS=128
# Includes active runs and sessions blocked by an unconfirmed commit; <= MAX_RUNS.
MERTINA_GATEWAY_MAX_ACTIVE_RUNS=8
# Retained events per run; each JSON event is limited to 64 KiB.
MERTINA_GATEWAY_EVENT_CAPACITY=256
# Must be >= EVENT_CAPACITY to attach a complete retained replay atomically.
MERTINA_GATEWAY_SUBSCRIBER_CAPACITY=256
MERTINA_GATEWAY_MAX_SUBSCRIBERS=8
MERTINA_GATEWAY_HEARTBEAT_S=15
# Slow SSE writes and incomplete request bodies are bounded independently.
MERTINA_GATEWAY_SEND_TIMEOUT_S=10
MERTINA_GATEWAY_BODY_TIMEOUT_S=10
