# Mertina Agent configuration.
#
# Copy this file to `.env` and fill in real values; `.env` is gitignored.
# Every variable is optional and falls back to the default shown here, except
# where noted. Environment variables always win over the `.env` file.

# Log threshold: DEBUG | INFO | WARNING | ERROR | CRITICAL
MERTINA_LOG_LEVEL=INFO

# Base URL of an OpenAI-compatible Chat Completions endpoint.
MERTINA_LLM_BASE_URL=https://api.openai.com/v1

# Credential for that endpoint. Required by hosted providers; leave empty for a
# local model server that needs no key. Never commit a real key.
MERTINA_LLM_API_KEY=

# Model name sent with every request.
MERTINA_LLM_MODEL=gpt-4o-mini

# Timeout for a single model request, in seconds. Must be greater than 0.
MERTINA_LLM_TIMEOUT_S=60

# Model calls one turn may spend on the tool loop before giving up. At least 1.
MERTINA_MAX_ITERATIONS=10
