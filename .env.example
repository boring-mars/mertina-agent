# Mertina Agent configuration.
#
# Copy this file to `.env` and fill in real values; `.env` is gitignored.
# Settings variables fall back to the defaults shown here. The explicit model
# smoke example requires an existing env file and explicitly supplied endpoint
# and model. Environment variables always win over the `.env` file.

# Log threshold: DEBUG | INFO | WARNING | ERROR | CRITICAL
MERTINA_LOG_LEVEL=INFO

# Base HTTP(S) URL of an OpenAI-compatible Chat Completions endpoint. Choose the
# actual service you intend to call; hosted requests may incur charges. Use only
# the base path, without URL credentials, query parameters or a fragment.
MERTINA_LLM_BASE_URL=https://api.openai.com/v1

# Credential for that endpoint, if required. Leave empty for an unauthenticated
# endpoint: no Authorization header is sent, and OPENAI_API_KEY is never used as
# a fallback. Never commit a real key.
MERTINA_LLM_API_KEY=

# Non-empty model name sent with every request; use a name your endpoint supports.
MERTINA_LLM_MODEL=gpt-4o-mini

# SDK network-operation timeout in seconds, not a total agent-turn deadline.
# Must be greater than 0. The SDK itself never retries; see the next setting.
MERTINA_LLM_TIMEOUT_S=60

# Attempts per model call, including the first. Timeouts, connection failures,
# HTTP 408/429/5xx and malformed responses are retried with jittered backoff
# (or the provider's Retry-After). Must be at least 1; 1 disables retries.
MERTINA_LLM_MAX_ATTEMPTS=3

# Stream model responses so text and tool progress are reported as they arrive.
# Set to false for endpoints that do not support streaming.
MERTINA_LLM_STREAM=true

# Model calls one agent turn may spend on the tool loop before the agent asks
# the model for a summary. Must be at least 1.
MERTINA_MAX_ITERATIONS=10

# Provider behind the web_search tool. Only ddgs (DuckDuckGo, no API key) is
# available; it runs each search in a separate process.
MERTINA_WEB_SEARCH_BACKEND=ddgs

# Hard wall-clock limit in seconds for one web search. Must be greater than 0.
MERTINA_WEB_SEARCH_TIMEOUT_S=30
