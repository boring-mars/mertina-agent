# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments (uv creates .venv)
.venv/
venv/
env/

# Build and packaging
build/
dist/
*.egg-info/
.eggs/
wheels/

# Tests, coverage and tool caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Environment and secrets — never commit real credentials
.env
.env.*
!.env.example
mertina.toml
*.pem
*.key

# Local data and logs
*.log
*.sqlite
*.sqlite3
*.db

# IDEs and editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Claude Code local settings
.claude/settings.local.json
