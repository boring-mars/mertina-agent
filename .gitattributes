# Normalize line endings: store text files with LF in the repository
# and check them out with LF on every platform.
* text=auto eol=lf

# Windows scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.whl binary

# Generated lock file: collapse in diffs on GitHub
uv.lock linguist-generated=true
